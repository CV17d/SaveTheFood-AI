# ─── SaveTheFood AI — Environment Configuration ──────────
# Copy this file to .env and fill in the values.

# ─── Gemini API ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# ─── Database ────────────────────────────────────────────
DATABASE_URL=sqlite:///data/db/savethefood.db

# ─── OCR Configuration ───────────────────────────────────
# Options: "pytesseract" | "gemini_vision"
OCR_STRATEGY=pytesseract
TESSERACT_CMD_PATH=/usr/bin/tesseract

# ─── Application ─────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ─── Caching (Gemini Proxy) ──────────────────────────────
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=256
